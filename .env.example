# Gemeinsame Konfiguration für die Workshop-Tracks.
# Persönliche API-Keys niemals committen oder mit anderen Personen teilen.
SCADS_API_KEY=your-api-key-here
SCADSAI_API_KEY=your-api-key-here-again
SCADS_BASE_URL=https://llm.scads.ai/v1
SCADS_MODEL=Qwen/Qwen3.8-27B

# API Base URL
SCADSAI_API_BASE=https://llm.scads.ai/v1

# Chat-Modell für Reasoning, Tool-Auswahl und Prompt-Enhancement.
# Alternativen: alias-huge, alias-code, alias-reasoning
SCADSAI_CHAT_MODEL=alias-vision

# Lesetimeout je LLM-Aufruf in Sekunden.
# Reasoning-Modelle wie Qwen3.8-27B brauchen pro Antwort oft >60s;
# bei ausgelastetem Cluster ruhig weiter erhöhen.
SCADSAI_REQUEST_TIMEOUT=180

# Zeitbudget des Browsers für einen kompletten Vergleichslauf in Sekunden.
# Ein Lauf sind bis zu 5 sequenzielle LLM-Aufrufe (gemessen: ~173 s), der
# Wert muss also deutlich über SCADSAI_REQUEST_TIMEOUT liegen.
FRONTEND_REQUEST_TIMEOUT=300

# MCP Server
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
